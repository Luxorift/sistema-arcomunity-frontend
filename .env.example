# Copia este archivo como .env.local y completa los valores de tu proyecto Supabase
# (Dashboard > Project Settings > API). Nunca subas .env.local al repositorio.

# Públicas: viajan al navegador. Usa la clave "anon" o "publishable", nunca la secreta.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-o-publishable

# Solo para scripts locales de administración (seed de demostración). NO usar prefijo VITE_.
# La clave service_role / secret key salta RLS: mantenla fuera del frontend y del repositorio.
SUPABASE_SERVICE_ROLE_KEY=
