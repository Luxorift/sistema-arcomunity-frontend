    "test:navegadores": "node --env-file=.env.local scripts/prueba-navegadores.ts",
    "dataset:apf3": "node --env-file=.env.local scripts/exportar-dataset-apf3.ts",
    "test:ui": "node --env-file=.env.local scripts/auditoria-ui.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "recharts": "^3.0.0",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright-core": "^1.65.1",
    "typescript": "~5.9.0",
