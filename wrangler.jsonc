// Despliegue alternativo en Cloudflare Workers (recursos estáticos, plan gratuito). Mismo código y mismo
// Supabase que Vercel. Las variables VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY se definen en Cloudflare →
// Workers → sistema-arcomunity-frontend → Settings → Build → Variables (solo la clave pública, nunca la de
// servicio). Las rutas internas (/admin/…) devuelven index.html (aplicación de una sola página).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sistema-arcomunity-frontend",
  "compatibility_date": "2026-11-01",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
